{
  "manifest_version": 3,
  "name": "卫戍协议拿牌器",
  "version": "0.3.10",
  "description": "卫戍协议网页版辅助工具：管理买入与保留名单，支持自动倒转、道具抓取与独立悬浮开关。自动交易仅在手动启动后运行。",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": ["https://weishuxieyiwangye.cn/*", "https://weishuxieyi.icu/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "图标.png",
    "32": "图标.png",
    "48": "图标.png",
    "128": "图标.png"
  },
  "action": {
    "default_title": "卫戍协议拿牌器｜打开或收起工作台",
    "default_icon": {
      "16": "图标.png",
      "32": "图标.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://weishuxieyiwangye.cn/*", "https://weishuxieyi.icu/*", "http://127.0.0.1/*"],
      "js": ["desktop-boot.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "src/*.js",
        "styles/*.css",
        "data/catalogue.json",
        "图标.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
